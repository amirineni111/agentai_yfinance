# =============================================================================
# Streamlit Trading Dashboard - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control.
# =============================================================================

# --- SQL Server Connection ---
SQL_SERVER=localhost\MSSQLSERVER01
SQL_DATABASE=stockdata_db
SQL_DRIVER={ODBC Driver 17 for SQL Server}

# Use Windows Authentication (set to "yes", leave username/password empty)
# Or SQL Authentication (set to "no", fill in username/password)
SQL_TRUSTED_CONNECTION=yes
SQL_USERNAME=
SQL_PASSWORD=

# --- For Remote Access from Machine B ---
# SQL_SERVER=192.168.x.x\MSSQLSERVER01
# SQL_TRUSTED_CONNECTION=no
# SQL_USERNAME=your_sql_login
# SQL_PASSWORD=your_sql_password

# --- OpenAI (optional, for GenAI features) ---
OPENAI_API_KEY=
